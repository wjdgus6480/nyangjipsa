# =====================================================================
# 이 파일을 복사해서 .env 파일을 만든 뒤 값을 채웁니다.
#   (PowerShell, nyangjipsa 폴더에서)  Copy-Item .env.example .env
# .env 는 .gitignore 에 등록되어 있어 Git 에 올라가지 않습니다.
# 이 파일(.env.example)에는 절대 실제 비밀번호나 API 키를 적지 않습니다.
# =====================================================================

# ---- PostgreSQL + PostGIS (docker-compose.yml 이 사용) ----
POSTGRES_USER=nyangjipsa
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=nyangjipsa
POSTGRES_PORT=5432

# ---- 백엔드 / SQLx 가 사용하는 접속 주소 ----
# 형식: postgres://<사용자>:<비밀번호>@<호스트>:<포트>/<DB이름>
# 위 POSTGRES_* 값과 반드시 일치시켜야 합니다.
DATABASE_URL=postgres://nyangjipsa:change_me_local_only@127.0.0.1:5432/nyangjipsa

# ---- 백엔드 서버 ----
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# development | production
APP_ENV=development
# 로그 레벨 (trace < debug < info < warn < error)
RUST_LOG=info,nyangjipsa_api=debug,tower_http=info

# ---- 공공데이터포털(data.go.kr) API ----
PUBLIC_DATA_BASE_URL=https://apis.data.go.kr
# 마이페이지의 "일반 인증키(Decoding)" 값을 넣습니다. (Encoding 키 아님)
PUBLIC_DATA_SERVICE_KEY=
# 공공데이터 자동 동기화 주기(시간). 0 이면 끔(기본). 켜면 서버 실행 중 변경분을 주기적으로 받아 옴
SYNC_INTERVAL_HOURS=0

# ---- 챗봇 (Gemini) ----
# 키가 없으면 챗봇이 꺼집니다 (/api/chat 은 503)
GEMINI_API_KEY=
# 사용 가능한 모델은 키마다 다를 수 있습니다 (models 목록 API 로 확인)
GEMINI_MODEL=gemini-3.5-flash-lite
# 기본 모델이 실패(일시 오류·한도 초과·모델 없음)하면 한 번 더 시도할 보조 모델. 빈 값이면 사용 안 함
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# 무료 한도 보호: 전체 분당 Gemini 호출 상한 / 클라이언트(IP)당 분당 요청 상한
CHAT_GLOBAL_RPM=10
CHAT_IP_RPM=5

# ---- 길찾기 (카카오맵 경로 조회: 도보·대중교통) ----
# developers.kakao.com 앱의 [카카오맵 > 사용 설정] ON 후 [앱 설정 > 플랫폼 키]의 REST API 키 (JavaScript 키 아님)
# 서버에서만 사용합니다. 비어 있으면 /api/route 는 503
KAKAO_REST_API_KEY=

# ---- 병원 공유 (카카오톡 공유 카드·공유 링크) ----
# 공유 링크 /s/{code} 의 앞부분 (백엔드 공개 주소). 카카오톡 미리보기는 인터넷에서 열리는 주소여야 보입니다
PUBLIC_BASE_URL=http://localhost:8080
# 공유 링크를 열면 이동할 냥집사 화면(React) 주소
FRONTEND_BASE_URL=http://localhost:5173
# 공유 카드 이미지 (비우면 FRONTEND_BASE_URL/assets/logo.png)
SHARE_IMAGE_URL=

# ---- 지도 API (미정: 네이버 / 카카오 중 확정 후 사용) ----
# MAP_PROVIDER=
# NAVER_MAP_CLIENT_ID=
# KAKAO_MAP_JS_KEY=
