# =====================================================================
# 이 파일을 복사해서 .env 파일을 만든 뒤 값을 채웁니다.
#   (PowerShell, nyangjipsa 폴더에서)  Copy-Item .env.example .env
# .env 는 .gitignore 에 등록되어 있어 Git 에 올라가지 않습니다.
# 이 파일(.env.example)에는 절대 실제 비밀번호나 API 키를 적지 않습니다.
# =====================================================================

# ---- PostgreSQL + PostGIS (docker-compose.yml 이 사용) ----
POSTGRES_USER=nyangjipsa
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=nyangjipsa
POSTGRES_PORT=5432

# ---- 백엔드 / SQLx 가 사용하는 접속 주소 ----
# 형식: postgres://<사용자>:<비밀번호>@<호스트>:<포트>/<DB이름>
# 위 POSTGRES_* 값과 반드시 일치시켜야 합니다.
DATABASE_URL=postgres://nyangjipsa:change_me_local_only@127.0.0.1:5432/nyangjipsa

# ---- 백엔드 서버 ----
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# development | production
APP_ENV=development
# 로그 레벨 (trace < debug < info < warn < error)
RUST_LOG=info,nyangjipsa_api=debug,tower_http=info

# ---- 공공데이터포털(data.go.kr) API ----
PUBLIC_DATA_BASE_URL=https://apis.data.go.kr
# 마이페이지의 "일반 인증키(Decoding)" 값을 넣습니다. (Encoding 키 아님)
PUBLIC_DATA_SERVICE_KEY=

# ---- 지도 API (미정: 네이버 / 카카오 중 확정 후 사용) ----
# MAP_PROVIDER=
# NAVER_MAP_CLIENT_ID=
# KAKAO_MAP_JS_KEY=
