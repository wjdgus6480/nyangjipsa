# =====================================================================
# 이 파일을 복사해서 .env 파일을 만든 뒤 값을 채웁니다.
#   (PowerShell, nyangjipsa 폴더에서)  Copy-Item .env.example .env
# .env 는 .gitignore 에 등록되어 있어 Git 에 올라가지 않습니다.
# 이 파일(.env.example)에는 절대 실제 비밀번호나 API 키를 적지 않습니다.
# =====================================================================

# ---- PostgreSQL + PostGIS (docker-compose.yml 이 사용) ----
POSTGRES_USER=nyangjipsa
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=nyangjipsa
POSTGRES_PORT=5432

# ---- 백엔드 / SQLx 가 사용하는 접속 주소 ----
# 형식: postgres://<사용자>:<비밀번호>@<호스트>:<포트>/<DB이름>
# 위 POSTGRES_* 값과 반드시 일치시켜야 합니다.
DATABASE_URL=postgres://nyangjipsa:change_me_local_only@127.0.0.1:5432/nyangjipsa

# ---- 백엔드 서버 ----
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# development | production
APP_ENV=development
# 로그 레벨 (trace < debug < info < warn < error)
RUST_LOG=info,nyangjipsa_api=debug,tower_http=info
# 배포 전용: Cloudflare Pages Functions 프록시(02_frontend/functions)와 같은 임의의 긴 비밀값.
# 일치할 때만 프록시가 넘긴 사용자 IP(x-client-ip)를 요청 제한에 사용. 로컬 개발은 비워 둠
# PROXY_SHARED_SECRET=

# ---- 공공데이터포털(data.go.kr) API ----
PUBLIC_DATA_BASE_URL=https://apis.data.go.kr
# 마이페이지의 "일반 인증키(Decoding)" 값을 넣습니다. (Encoding 키 아님)
PUBLIC_DATA_SERVICE_KEY=
# 공공데이터 자동 동기화 주기(시간). 0 이면 끔(기본). 켜면 서버 실행 중 변경분을 주기적으로 받아 옴
SYNC_INTERVAL_HOURS=0

# ---- 챗봇 (Gemini) ----
# 키가 없으면 챗봇이 꺼집니다 (/api/chat 은 503)
GEMINI_API_KEY=
# 사용 가능한 모델은 키마다 다를 수 있습니다 (models 목록 API 로 확인)
GEMINI_MODEL=gemini-3.5-flash-lite
# 기본 모델이 실패(일시 오류·한도 초과·모델 없음)하면 한 번 더 시도할 보조 모델. 빈 값이면 사용 안 함
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# 무료 한도 보호: 전체 분당 Gemini 호출 상한 / 클라이언트(IP)당 분당 요청 상한
CHAT_GLOBAL_RPM=10
CHAT_IP_RPM=5

# ---- 길찾기 (카카오맵 경로 조회: 도보·대중교통) ----
# developers.kakao.com 앱의 [카카오맵 > 사용 설정] ON 후 [앱 설정 > 플랫폼 키]의 REST API 키 (JavaScript 키 아님)
# 서버에서만 사용합니다. 비어 있으면 /api/route 는 503
KAKAO_REST_API_KEY=

# ---- 관리자 대시보드 (Amplitude 조회) ----
# Amplitude [Settings > Projects > 프로젝트] 의 API Key 와 Secret Key (프론트 VITE_AMPLITUDE_API_KEY 와 같은 프로젝트)
# Secret Key 는 서버 전용입니다. 둘 중 하나라도 비면 대시보드의 행동 데이터 영역이 "연결 안 됨" 으로 보입니다
# 프로젝트 시간대를 Asia/Seoul 로 맞춰 두세요 (날짜 기준). EU 프로젝트면 AMPLITUDE_DASHBOARD_URL=https://analytics.eu.amplitude.com
AMPLITUDE_API_KEY=
AMPLITUDE_SECRET_KEY=
# AMPLITUDE_DASHBOARD_URL=

# ---- 콘텐츠 스튜디오 (Google Sheets 읽기, GAS 웹앱) ----
# 06_gas/README.md 순서대로 GAS 웹앱을 배포한 뒤 주소와 비밀값(GAS 스크립트 속성 CONTENT_STUDIO_SECRET 과 같은 값, 16자 이상)을 넣습니다
# 서버 전용입니다. 둘 중 하나라도 비면 콘텐츠 스튜디오 조회가 "연결 안 됨"(503)으로 보입니다
GAS_WEBAPP_URL=
GAS_WEBAPP_SECRET=

# ---- 병원 공유 (카카오톡 공유 카드·공유 링크) ----
# 공유 링크 /s/{code} 의 앞부분 (백엔드 공개 주소). 카카오톡 미리보기는 인터넷에서 열리는 주소여야 보입니다
PUBLIC_BASE_URL=http://localhost:8080
# 공유 링크를 열면 이동할 냥집사 화면(React) 주소. 비우면 APP_BASE_URL(회원 인증의 프론트 주소)을 씀
FRONTEND_BASE_URL=
# 공유 카드 이미지 (비우면 FRONTEND_BASE_URL/assets/logo.png)
SHARE_IMAGE_URL=
# ---- 회원 인증 (세션·메일·소셜 로그인) — 자세한 설정: 04_docs/07_회원_인증_구현_기록.md ----
# 프론트엔드 주소: 인증·재설정 메일 링크와 소셜 로그인 후 이동에 사용. 운영(production)에서는 필수(https)
APP_BASE_URL=http://localhost:5173
# 쿠키 Secure(HTTPS 전용). 비우면 운영 true / 개발 false
# COOKIE_SECURE=
# 세션 유지 시간: 로그인 상태 유지 끔(시간) / 켬·소셜 로그인(일)
# SESSION_HOURS=24
# SESSION_REMEMBER_DAYS=30
# 회원 API 상태 변경 요청을 추가로 허용할 출처(쉼표 구분). APP_BASE_URL 출처는 자동 허용
# AUTH_ALLOWED_ORIGINS=

# 메일 발송: disabled(기본, 보내지 않음) | log(개발 전용: 링크를 서버 로그에 출력, 운영에서는 시작 거부) | smtp
MAIL_MODE=log
# MAIL_MODE=smtp 일 때 (업체 무관 SMTP). SMTP_TLS=starttls(587, 기본) | tls(465)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=냥집사 <no-reply@example.com>
# SMTP_TLS=starttls

# 카카오 로그인 (developers.kakao.com: [카카오 로그인] 활성화, Redirect URI 등록, 동의항목에 이메일·닉네임)
# REST API 키는 길찾기 키와 같은 앱이면 같은 값을 넣어도 됩니다. 셋 중 REST 키·Redirect URI 는 함께 필요
# KAKAO_LOGIN_REST_API_KEY=
# KAKAO_LOGIN_CLIENT_SECRET=
# KAKAO_LOGIN_REDIRECT_URI=http://localhost:5173/api/auth/kakao/callback

# 구글 로그인 (Google Cloud 콘솔: OAuth 동의 화면 + OAuth 클라이언트 ID(웹 애플리케이션), 승인된 리디렉션 URI 등록)
# 셋 모두 필요
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=
# GOOGLE_LOGIN_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

# ---- 지도 API (미정: 네이버 / 카카오 중 확정 후 사용) ----
# MAP_PROVIDER=
# NAVER_MAP_CLIENT_ID=
# KAKAO_MAP_JS_KEY=
