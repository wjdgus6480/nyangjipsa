{
  "name": "nyangjipsa-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "냥집사 프론트엔드 (React + TypeScript + Vite). 기존 serve.js·map-poc 테스트가 CommonJS 라서 type:module 을 쓰지 않고 설정 파일만 .mjs/.mts 로 둡니다",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "node --test \"map-poc/tests/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:legacy && vite build"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "2.49.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/navermaps": "^3.10.1",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
