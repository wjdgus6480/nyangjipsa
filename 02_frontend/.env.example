# 02_frontend/.env.local 로 복사해서 필요한 값만 바꿉니다 (.env.local 은 Git 제외).
# 아무것도 안 바꿔도 기본값으로 동작합니다.

# 개발 서버 포트 (기본 5173). 기존 serve.js 는 5520 이라 동시에 띄워 비교할 수 있습니다.
# FRONTEND_PORT=5173

# 개발 서버가 /api, /health 를 넘겨줄 Rust 백엔드 주소 (기본 http://localhost:8080)
# BACKEND_URL=http://localhost:8080

# 브라우저가 호출할 API 주소. 비우면 같은 출처(/api/…) — 개발은 위 프록시, 배포는 리버스 프록시 권장
# (백엔드는 APP_ENV=development 일 때만 CORS 를 허용합니다)
# VITE_API_BASE=

# ---- 배포(Cloudflare Pages) 전용: 이 파일이 아니라 Pages 프로젝트 환경변수에 넣습니다 ----
# functions/api/[[path]].js 프록시가 /api/* 를 Render 로 전달합니다 (VITE_API_BASE 는 비워 둠)
# BACKEND_ORIGIN=https://<서비스명>.onrender.com
# PROXY_SHARED_SECRET=   (Render 의 PROXY_SHARED_SECRET 과 같은 값, 비밀)
# NODE_VERSION=22

# 네이버 지도 Client ID. 비우면 저장소 루트 .env 의 NAVER_MAP_CLIENT_ID 를 씁니다
# VITE_NAVER_MAP_CLIENT_ID=

# Amplitude 제품 분석 (프로젝트 설정의 API Key — 브라우저 공개용). 비우면 이벤트를 보내지 않습니다
# 회원가입·로그인 이벤트만 보내며 이메일·비밀번호·토큰 등 개인정보는 보내지 않습니다
# VITE_AMPLITUDE_API_KEY=
# EU 데이터센터 프로젝트일 때만
# VITE_AMPLITUDE_SERVER_URL=https://api.eu.amplitude.com/2/httpapi
