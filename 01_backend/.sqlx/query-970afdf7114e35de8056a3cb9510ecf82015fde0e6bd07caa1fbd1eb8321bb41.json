  "query": "\n        SELECT ST_X(b.location::geometry) AS \"lon!\",\n               ST_Y(b.location::geometry) AS \"lat!\",\n               b.address_masked\n        FROM animal_businesses b\n        WHERE b.status_code = '01'\n          AND b.location IS NOT NULL\n          AND ($1::text[] IS NULL OR b.business_type = ANY($1))\n        ORDER BY b.id\n        ",
